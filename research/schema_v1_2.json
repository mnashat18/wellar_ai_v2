{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wellar-v2-research-manifest-1.2",
  "title": "Wellar V2 consent-gated pilot feature record 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sample_id", "participant_id", "session_id", "identity_linkage", "provenance", "consent", "context", "modality_availability", "features", "labels"],
  "properties": {
    "schema_version": {"const": "1.2"},
    "fixture_marker": {"const": "unit_test_synthetic", "description": "Test-only; never eligible as human research data."},
    "sample_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"},
    "participant_id": {"type": "string", "minLength": 3, "description": "Opaque pseudonym; do not place the linkage key here."},
    "session_id": {"type": "string", "minLength": 3},
    "identity_linkage": {"type": "object", "required": ["pseudonymized", "linkage_key_stored_separately", "linkage_governance_id"], "properties": {"pseudonymized": {"const": true}, "linkage_key_stored_separately": {"const": true}, "linkage_governance_id": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "provenance": {"type": "object", "required": ["study_id", "dataset_id", "dataset_version", "source_reference", "acquisition_protocol_id", "curator_role"], "properties": {"study_id": {"type": "string"}, "dataset_id": {"type": "string"}, "dataset_version": {"type": "string"}, "source_reference": {"type": "string"}, "acquisition_protocol_id": {"type": "string"}, "curator_role": {"type": "string"}}, "additionalProperties": false},
    "consent": {"type": "object", "required": ["status", "consent_reference", "consented_at_utc", "permissions"], "properties": {"status": {"const": "granted"}, "consent_reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"}, "consented_at_utc": {"type": "string", "format": "date-time"}, "permissions": {"type": "object", "required": ["media_analysis", "media_storage", "model_training", "evaluation", "cross_site_transfer"], "properties": {"media_analysis": {"type": "boolean"}, "media_storage": {"type": "boolean"}, "model_training": {"type": "boolean"}, "evaluation": {"type": "boolean"}, "cross_site_transfer": {"type": "boolean"}}, "additionalProperties": false}}, "additionalProperties": false},
    "context": {"type": "object", "required": ["recorded_at_utc", "site_id", "device_id", "industry", "occupation"], "properties": {"recorded_at_utc": {"type": "string", "format": "date-time"}, "site_id": {"type": ["string", "null"]}, "device_id": {"type": ["string", "null"]}, "industry": {"type": ["string", "null"]}, "occupation": {"type": ["string", "null"]}}, "additionalProperties": false},
    "modality_availability": {"type": "object", "required": ["video", "audio", "image", "reaction_task"], "properties": {"video": {"$ref": "#/$defs/availability"}, "audio": {"$ref": "#/$defs/availability"}, "image": {"$ref": "#/$defs/availability"}, "reaction_task": {"$ref": "#/$defs/availability"}}, "additionalProperties": false},
    "features": {"type": "object", "required": ["video", "audio", "image", "reaction_task"], "properties": {"video": {"$ref": "#/$defs/features"}, "audio": {"$ref": "#/$defs/features"}, "image": {"$ref": "#/$defs/features"}, "reaction_task": {"$ref": "#/$defs/features"}}, "additionalProperties": false},
    "labels": {"type": "object", "required": ["reference_sleepiness", "subjective_fatigue", "vigilance_performance", "eye_state_event", "mouth_opening_event"], "properties": {"reference_sleepiness": {"$ref": "#/$defs/label"}, "subjective_fatigue": {"$ref": "#/$defs/label"}, "vigilance_performance": {"$ref": "#/$defs/label"}, "eye_state_event": {"$ref": "#/$defs/eventLabel"}, "mouth_opening_event": {"$ref": "#/$defs/eventLabel"}}, "additionalProperties": false}
  },
  "$defs": {
    "availability": {"enum": ["available", "missing", "failed", "not_collected", "unknown"]},
    "features": {"type": "object", "required": ["values", "provenance"], "properties": {"values": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}, "provenance": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false},
    "label": {"type": "object", "required": ["status", "label_definition_id"], "properties": {"status": {"enum": ["observed", "missing", "unknown"]}, "raw_value": {"type": ["number", "null"]}, "class_label": {"type": ["integer", "string", "null"]}, "classification_rule_id": {"type": "string"}, "label_definition_id": {"type": "string"}, "instrument": {"type": "string"}, "qualified": {"type": "boolean"}, "qualification_reference": {"type": "string"}, "metric": {"type": "string"}, "protocol_id": {"type": "string"}, "unit": {"type": "string"}, "source_reference": {"type": "string"}, "assessor_role": {"type": "string"}, "measured_at_utc": {"type": "string", "format": "date-time"}, "missing_reason": {"type": "string"}}, "additionalProperties": true},
    "eventLabel": {"allOf": [{"$ref": "#/$defs/label"}, {"type": "object", "properties": {"instrument": {"const": "direct_visual_annotation"}, "event_type": {"enum": ["eye_state", "mouth_opening"]}, "raw_value": {"enum": [0, 1]}, "class_label": {"enum": [0, 1]}, "unit": {"const": "binary_direct_event_class"}}}]}
  }
}
