# Template only. Use a dedicated isolated staging stack and secret store.
# Never copy production credentials or commit a populated .env file.
WELLAR_ENV=staging
WELLAR_AUTH_MODE=directus
WELLAR_DIRECTUS_URL=https://<isolated-directus-staging-host>
WELLAR_DIRECTUS_TIMEOUT_SECONDS=3
# Incoming user-session validation uses each caller's bearer token.
# Do not set WELLAR_DIRECTUS_SERVICE_TOKEN for this purpose.
WELLAR_DIRECTUS_PULL_ENABLED=false

# Required by deployment/docker-compose.scalable.yml for the isolated V2 stack.
WELLAR_POSTGRES_DSN=postgresql://<staging-user>:<secret>@<isolated-db-host>:5432/<staging-db>?sslmode=verify-full
WELLAR_S3_BUCKET=<private-staging-bucket>
WELLAR_S3_REGION=<staging-region>
WELLAR_S3_ENDPOINT_URL=<https://private-staging-object-store>
WELLAR_API_CPU_LIMIT=<operator-sized-after-capacity-evidence>
WELLAR_API_MEMORY_LIMIT=<operator-sized-after-capacity-evidence>
WELLAR_WORKER_CPU_LIMIT=<operator-sized-after-capacity-evidence>
WELLAR_WORKER_MEMORY_LIMIT=<operator-sized-after-capacity-evidence>
