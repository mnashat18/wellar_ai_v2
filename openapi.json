{
  "components": {
    "schemas": {
      "ClientMeasurements": {
        "additionalProperties": false,
        "properties": {
          "audio_quality_status": {
            "anyOf": [
              {
                "enum": [
                  "available",
                  "insufficient_quality",
                  "failed",
                  "not_provided"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio Quality Status"
          },
          "blink_rate_per_minute": {
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Blink Rate Per Minute",
            "type": "number"
          },
          "face_detection_ratio": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Face Detection Ratio",
            "type": "number"
          },
          "max_eye_closure_seconds": {
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Max Eye Closure Seconds",
            "type": "number"
          },
          "mean_blur_variance": {
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Mean Blur Variance",
            "type": "number"
          },
          "mean_eye_closure_seconds": {
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Mean Eye Closure Seconds",
            "type": "number"
          },
          "mean_luminance": {
            "maximum": 255.0,
            "minimum": 0.0,
            "title": "Mean Luminance",
            "type": "number"
          },
          "pitch_proxy": {
            "maximum": 5.0,
            "minimum": -5.0,
            "title": "Pitch Proxy",
            "type": "number"
          },
          "short_clip_eye_closure_fraction": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Short Clip Eye Closure Fraction",
            "type": "number"
          },
          "temporal_coverage": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Temporal Coverage",
            "type": "number"
          },
          "yaw_proxy": {
            "maximum": 5.0,
            "minimum": -5.0,
            "title": "Yaw Proxy",
            "type": "number"
          }
        },
        "required": [
          "short_clip_eye_closure_fraction",
          "blink_rate_per_minute",
          "mean_eye_closure_seconds",
          "max_eye_closure_seconds",
          "face_detection_ratio",
          "mean_luminance",
          "mean_blur_variance",
          "temporal_coverage",
          "yaw_proxy",
          "pitch_proxy"
        ],
        "title": "ClientMeasurements",
        "type": "object"
      },
      "DirectusProcessRequest": {
        "additionalProperties": false,
        "properties": {
          "audio_file_id": {
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Audio File Id",
            "type": "string"
          },
          "device_info": {
            "additionalProperties": true,
            "maxProperties": 32,
            "title": "Device Info",
            "type": "object"
          },
          "environment_info": {
            "additionalProperties": true,
            "maxProperties": 32,
            "title": "Environment Info",
            "type": "object"
          },
          "image_file_id": {
            "anyOf": [
              {
                "pattern": "^[0-9a-fA-F-]{36}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image File Id"
          },
          "scan_id": {
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Scan Id",
            "type": "string"
          },
          "task_metrics": {
            "additionalProperties": true,
            "maxProperties": 32,
            "title": "Task Metrics",
            "type": "object"
          },
          "user_id": {
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "User Id",
            "type": "string"
          },
          "video_file_id": {
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "Video File Id",
            "type": "string"
          }
        },
        "required": [
          "scan_id",
          "user_id",
          "video_file_id",
          "audio_file_id"
        ],
        "title": "DirectusProcessRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KSSLabelSubmission": {
        "additionalProperties": false,
        "properties": {
          "fatigue": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fatigue"
          },
          "focus": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Focus"
          },
          "kss": {
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Kss",
            "type": "integer"
          },
          "shift": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shift"
          },
          "time_of_day": {
            "anyOf": [
              {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Of Day"
          },
          "training_consent": {
            "title": "Training Consent",
            "type": "boolean"
          }
        },
        "required": [
          "kss",
          "training_consent"
        ],
        "title": "KSSLabelSubmission",
        "type": "object"
      },
      "MediaConsent": {
        "additionalProperties": false,
        "properties": {
          "media_processing": {
            "title": "Media Processing",
            "type": "boolean"
          },
          "research_use": {
            "default": false,
            "title": "Research Use",
            "type": "boolean"
          }
        },
        "required": [
          "media_processing"
        ],
        "title": "MediaConsent",
        "type": "object"
      },
      "ReactionTask": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "task_type": {
            "pattern": "^(pvt|simple_reaction)$",
            "title": "Task Type",
            "type": "string"
          },
          "timing_metadata": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "maxProperties": 16,
            "title": "Timing Metadata",
            "type": "object"
          },
          "trials": {
            "items": {
              "$ref": "#/components/schemas/ReactionTrial"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Trials",
            "type": "array"
          }
        },
        "required": [
          "task_type",
          "trials"
        ],
        "title": "ReactionTask",
        "type": "object"
      },
      "ReactionTrial": {
        "additionalProperties": false,
        "properties": {
          "response_timestamp_ms": {
            "anyOf": [
              {
                "maximum": 86400000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Timestamp Ms"
          },
          "stimulus_timestamp_ms": {
            "maximum": 86400000.0,
            "minimum": 0.0,
            "title": "Stimulus Timestamp Ms",
            "type": "integer"
          },
          "trial_index": {
            "maximum": 99.0,
            "minimum": 0.0,
            "title": "Trial Index",
            "type": "integer"
          }
        },
        "required": [
          "trial_index",
          "stimulus_timestamp_ms"
        ],
        "title": "ReactionTrial",
        "type": "object"
      },
      "ScanResult": {
        "properties": {
          "drowsiness_indicator": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drowsiness Indicator"
          },
          "evidence": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "features": {
            "additionalProperties": true,
            "title": "Features",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "model_invocation_status": {
            "default": "not_invoked_no_validated_model",
            "title": "Model Invocation Status",
            "type": "string"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "prediction_extension": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prediction Extension"
          },
          "quality": {
            "additionalProperties": true,
            "title": "Quality",
            "type": "object"
          },
          "scan_id": {
            "title": "Scan Id",
            "type": "string"
          },
          "schema_version": {
            "default": "2.0",
            "title": "Schema Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "subjective_reference": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subjective Reference"
          },
          "targets": {
            "additionalProperties": true,
            "title": "Targets",
            "type": "object"
          }
        },
        "required": [
          "scan_id",
          "status",
          "message"
        ],
        "title": "ScanResult",
        "type": "object"
      },
      "ScanStatus": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          },
          "scan_id": {
            "title": "Scan Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "scan_id",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ScanStatus",
        "type": "object"
      },
      "ScanSubmission": {
        "additionalProperties": false,
        "properties": {
          "consent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MediaConsent"
              },
              {
                "type": "null"
              }
            ]
          },
          "media_refs": {
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "title": "Media Refs",
            "type": "array"
          },
          "reaction_task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReactionTask"
              },
              {
                "type": "null"
              }
            ]
          },
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "subjective_fatigue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubjectiveFatigue"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "ScanSubmission",
        "type": "object"
      },
      "SubjectiveFatigue": {
        "additionalProperties": false,
        "description": "Optional, unvalidated Wellar research item; kept separate from predictions.",
        "properties": {
          "collection_consent": {
            "default": false,
            "title": "Collection Consent",
            "type": "boolean"
          },
          "instrument": {
            "default": "wellar_custom_fatigue_rating_0_10",
            "title": "Instrument",
            "type": "string"
          },
          "schema_version": {
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          }
        },
        "title": "SubjectiveFatigue",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Wellar AI V2",
    "version": "0.1.0"
  },
